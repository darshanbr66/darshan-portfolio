@theme {
  /* Typography */
  --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;

  /* Layout */
  --container-content: 72rem;

  /* Radii */
  --radius-sm: 0.375rem;
  --radius-md: 0.625rem;
  --radius-lg: 0.875rem;
  --radius-xl: 1.25rem;

  /* Shadows */
  --shadow-subtle: 0 1px 2px rgb(15 23 42 / 0.05);
  --shadow-card: 0 8px 30px rgb(15 23 42 / 0.06);

  /* Motion */
  --ease-standard: cubic-bezier(0.2, 0.8, 0.2, 1);
  --duration-fast: 150ms;
  --duration-normal: 250ms;
  --duration-slow: 400ms;

  /* Portfolio palette */
  --color-canvas: #f7f7f5;
  --color-surface: #ffffff;
  --color-surface-muted: #f1f1ee;

  --color-ink: #171717;
  --color-ink-soft: #404040;
  --color-ink-muted: #737373;

  --color-line: #deded9;
  --color-line-strong: #c9c9c2;

  --color-accent: #176b66;
  --color-accent-hover: #125752;
  --color-accent-soft: #e7f2f0;
}